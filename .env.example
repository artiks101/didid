# ===================================================
# Конфигурация Discord бота для логирования админов
# ===================================================

# Токен Discord бота (получить в Discord Developer Portal -> Bot -> Reset Token)
# Внимание: токен обычно выглядит как "MTI...xxxxxx.xxxxxx.xxxxxx"
DISCORD_BOT_TOKEN=your_bot_token_here

# ID текстового канала на вашем сервере, куда бот будет слать логи.
# (Включите режим разработчика в Discord: Настройки -> Расширенные -> Режим разработчика,
# затем ПКМ по нужному каналу -> Копировать ID канала)
LOG_CHANNEL_ID=0

# (Опционально) ID сервера (Guild ID). Если оставить пустым, бот работает на всех серверах, где он есть.
GUILD_ID=

# Логировать ли действия ботов-администраторов (True или False)
LOG_BOTS=False

